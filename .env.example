# Plantilla de configuracion SMTP para enviar.php
# Copiar a .env y rellenar con credenciales reales.
# El fichero .env NUNCA se sube a git (esta en .gitignore).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hola@associacioubuntu.org
SMTP_PASS=cambiar_por_app_password_de_16_chars
MAIL_FROM=info@associacioubuntu.org
MAIL_FROM_NAME="Associacio Ubuntu Web"
MAIL_TO=ubuntu@associacioubuntu.org
MAIL_TO_NAME="Associacio Ubuntu"
